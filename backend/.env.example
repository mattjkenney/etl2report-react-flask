# ==========================================
# Flask Backend Environment Configuration
# ==========================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# ==========================================
# Flask Configuration
# ==========================================
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=True

# Server Configuration
HOST=0.0.0.0
PORT=5000

# Logging
LOG_LEVEL=INFO

# ==========================================
# CORS Configuration
# ==========================================
# Comma-separated list of allowed frontend origins
# Development: Include localhost URLs
# Production: Use only your deployed frontend URL(s) - NO wildcards
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ==========================================
# AWS S3 Configuration
# ==========================================
# Default S3 bucket for file storage
# User-specific paths will be: users/{user_id}/...
S3_BUCKET=your-s3-bucket-name

# ==========================================
# API Gateway Endpoints (Lambda Proxies)
# ==========================================
# These endpoints are your existing Lambda functions deployed behind API Gateway
# The Flask backend proxies requests to these endpoints
# Find these URLs in AWS Console: API Gateway > Your API > Stages

# S3 Operations Lambda Endpoints
API_GATEWAY_S3_PRESIGNED_URL_ENDPOINT=https://your-api-id.execute-api.region.amazonaws.com/prod/s3-presigned-url
API_GATEWAY_S3_LIST_FOLDERS_ENDPOINT=https://your-api-id.execute-api.region.amazonaws.com/prod/s3-list-folders

# Textract Operations Lambda Endpoints
API_GATEWAY_TEXTRACT_START_ENDPOINT=https://your-api-id.execute-api.region.amazonaws.com/prod/textract-start-analysis
API_GATEWAY_TEXTRACT_GET_RESULTS_ENDPOINT=https://your-api-id.execute-api.region.amazonaws.com/prod/textract-get-results

# ==========================================
# Architecture Notes
# ==========================================
# 
# Request Flow:
#   Frontend → Flask Backend → API Gateway → Lambda → AWS Services
#
# Authentication:
#   1. Flask receives JWT token in Authorization header
#   2. Flask extracts user_id (sub) for S3 path building (no validation)
#   3. Flask passes token to API Gateway
#   4. API Gateway Cognito Authorizer validates token
#   5. Lambda receives validated user info from authorizer context
#
# User Path Structure:
#   users/{user_id}/templates/     - HTML templates
#   users/{user_id}/pdfs/          - PDF files
#   users/{user_id}/reports/       - Generated reports
#   users/{user_id}/textract/      - Textract results
#
# Lambda Functions:
#   - Lambda functions remain unchanged
#   - They are accessed via Flask backend (not directly from frontend)
#   - All existing API Gateway endpoints continue to work
#
# Security:
#   - DO NOT commit .env file with real values
#   - Keep .env in .gitignore
#   - Production: Use specific frontend URLs in CORS_ORIGINS (no wildcards)
#   - Production: Set FLASK_DEBUG=False
