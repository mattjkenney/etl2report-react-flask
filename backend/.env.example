# Flask Backend
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=True

# Server Configuration
HOST=0.0.0.0
PORT=5000

# CORS Origins (comma-separated list of allowed frontend URLs)
# Development: use localhost URLs
# Production: use your deployed frontend domain(s) only - NO wildcards or localhost
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging
LOG_LEVEL=INFO
